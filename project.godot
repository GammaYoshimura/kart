; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Kart Arcade 3D"
config/description="Juego de carreras arcade 3D multijugador."
config/version="0.1.0"
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.7")

[audio]

default_bus_layout="res://default_bus_layout.tres"

[autoload]

EventBus="*res://src/core/event_bus.gd"
AppBootstrap="*res://src/core/app_bootstrap.gd"
PerfMonitor="*res://src/core/performance_budget_monitor.gd"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/return_value_discarded=1

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

