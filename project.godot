; Engine configuration file.
; Kart Arcade 3D Multijugador
config_version=5

[application]
config/name="Kart Arcade 3D"
config/description="Juego de carreras arcade 3D multijugador."
config/version="0.1.0"
run/main_scene="res://scenes/boot/boot.tscn"

[physics]
3d/default_gravity=9.8
3d/default_gravity_vector=Vector3(0, -1, 0)
3d/default_linear_damp=0.0
3d/default_angular_damp=0.0
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8
common/physics_interpolation=true

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true

[layer_names]
3d_physics/layer_1="Track_Road"
3d_physics/layer_2="Track_Wall"
3d_physics/layer_3="Kart_Hull"
3d_physics/layer_4="Checkpoint_Trigger"
3d_physics/layer_5="ItemBox_Trigger"
3d_physics/layer_6="Projectile_Hazard"
3d_physics/layer_7="Killzone_Respawn"
3d_physics/layer_8="Boost_Zone"
3d_render/layer_1="World_Geometry"
3d_render/layer_2="Karts_And_Drivers"
3d_render/layer_3="VFX_Particles"
3d_render/layer_4="Minimap_Ortho_Only"
3d_render/layer_5="Editor_Debug_Gizmos"
[input]

accelerate={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194322)]
}
brake_reverse={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194324)]
}
