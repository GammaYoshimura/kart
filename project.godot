[layer_names]

3d_render/layer_1="World_Geometry"
3d_render/layer_2="Karts_And_Drivers"
3d_render/layer_3="VFX_Particles"
3d_render/layer_4="Minimap_Ortho_Only"
3d_render/layer_5="Editor_Debug_Gizmos"
3d_physics/layer_1="Track_Road"
3d_physics/layer_2="Track_Wall"
3d_physics/layer_3="Kart_Hull"
3d_physics/layer_4="Checkpoint_Trigger"
3d_physics/layer_5="ItemBox_Trigger"
3d_physics/layer_6="Projectile_Hazard"
3d_physics/layer_7="Killzone_Respawn"
3d_physics/layer_8="Boost_Zone"

[physics]

3d/default_linear_damp=0.0
3d/default_angular_damp=0.0
common/physics_interpolation=true

[rendering]

textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
